<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Wallpaper -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Soft top-to-bottom scrim gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_gradient" />

    <!-- Main Vertical Scroll View containing Header, Tools Row, and Category Rows -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingTop="36dp"
            android:paddingEnd="56dp"
            android:paddingBottom="48dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Header: Top Left Greeting, Clock, Date | Top Right Search, QR Tile, Net Icon, Wallpaper -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/headerLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B0C0E0"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04" />

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="56sp"
                        android:fontFamily="sans-serif-thin"
                        android:format12Hour="h:mm a"
                        android:format24Hour="HH:mm" />

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#99AABB"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-light"
                        android:format12Hour="EEEE, MMMM d"
                        android:format24Hour="EEEE, MMMM d" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignTop="@id/headerLeft"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Glass Search Pill -->
                    <TextView
                        android:id="@+id/searchPillBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="18dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/pill_bg"
                        android:layout_marginEnd="16dp" />

                    <!-- Home QR Tile (~110x110dp white rounded card, focusable) -->
                    <LinearLayout
                        android:id="@+id/homeQrCard"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/qr_tile_bg"
                        android:padding="6dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/homeQrImageView"
                            android:layout_width="82dp"
                            android:layout_height="82dp"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/homeQrCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scan to pair"
                            android:textColor="#333333"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/homeQrOfflineText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No network"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:visibility="gone" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/netIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_net_offline"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:id="@+id/wallpaperBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wallpaper"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="22dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/pill_bg" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Always-Visible Tools Compact Row (~24dp bottom margin to category header) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/toolsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="56dp"
                android:paddingBottom="6dp" />

            <!-- Category Rows Container -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rowsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Search Overlay Panel -->
    <FrameLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60B0F1A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ScrollView
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:padding="14dp"
                    android:background="@drawable/pill_bg"
                    android:layout_marginTop="16dp" />

                <!-- Filtered Installed Apps List -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Installed Apps"
                    android:textColor="#B0C0E0"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="20dp" />

                <LinearLayout
                    android:id="@+id/searchAppResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />

                <!-- External Web & YouTube Search Actions -->
                <LinearLayout
                    android:id="@+id/searchWebBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/pill_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginTop="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_search" />

                    <TextView
                        android:id="@+id/searchWebText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search the web"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/searchYoutubeBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/pill_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_search" />

                    <TextView
                        android:id="@+id/searchYoutubeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search YouTube"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:id="@+id/closeSearchPanelBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Close"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="24dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/pill_bg" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Dimmed Pairing Overlay Panel -->
    <FrameLayout
        android:id="@+id/pairingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60B0F1A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ScrollView
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/card_bg"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pair Phone Remote"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/pairingInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B0C0E0"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

                <!-- QR Code Container -->
                <FrameLayout
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:background="#FFFFFF"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/qrImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <!-- Paired Devices List Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Paired Devices"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="24dp" />

                <LinearLayout
                    android:id="@+id/pairedDevicesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/noDevicesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No devices paired yet"
                    android:textColor="#8090A8"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:id="@+id/removeAllBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remove All"
                        android:textColor="#FF6B6B"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="18dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/pill_bg"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/closePanelBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Close"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="24dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/pill_bg" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Dimmed Hidden Apps Overlay Panel -->
    <FrameLayout
        android:id="@+id/hiddenAppsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60B0F1A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ScrollView
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/card_bg"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hidden Apps"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:id="@+id/hiddenAppsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/noHiddenAppsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No hidden apps"
                    android:textColor="#8090A8"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:id="@+id/unhideAllBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unhide All"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="18dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/pill_bg"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/closeHiddenPanelBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Close"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="24dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/pill_bg" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
